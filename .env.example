# Copy this file and name the copy ".env.local". Then fill in your own keys.
# .env.local is in .gitignore and is never uploaded.
# See docs/05-stripe-payments.md and docs/08-supabase-stock.md.

# Stripe secret key – starts with sk_test_ (test mode) or sk_live_ (real money)
# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_REPLACE_ME

# Signing secret of the Stripe webhook (lowers the stock after a purchase) – starts with whsec_
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# The site's address. Locally: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (stock) – from Supabase: Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Secret! Only used on the server, never with NEXT_PUBLIC_ in front.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
